<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Revit releases. To support a new Revit release, add its two digit year to RevitReleases (nothing else here changes).
    Releases from FirstProgramFilesRelease are installed under Program Files, earlier ones under ProgramData.
    Releases from FirstIsolatedRelease load the IsolateWarnings_Isolated.addin manifest (installed under the normal name).
  -->
  <?define RevitReleases="22;23;24;25;26;27"?>
  <?define FirstProgramFilesRelease="27"?>
  <?define FirstIsolatedRelease="26"?>

  <!-- Registry location. This is what the previous Advanced Installer package wrote, so it MUST stay. -->
  <?define RegistryKey="Software\Russell Green\Isolate Warnings"?>

  <!--
    The UpgradeCode MUST NEVER change. It is the code the previous Advanced Installer package used, so this package
    upgrades existing installations. The ProductCode is generated per build.
  -->
  <Package Name="Isolate Warnings"
           Manufacturer="Russ Green"
           Version="$(var.ProductVersion)"
           UpgradeCode="B7A94109-FB59-4E4B-AEC1-39C79BFFFFCD" 
           Language="1033"
           Scope="perMachine">

    <SummaryInformation Description="Isolate Warnings installer" />

    <!-- AllowSameVersionUpgrades needs ICE61 suppressed in the wixproj. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ARPPRODUCTICON must be the Id of an Icon element, never a file path. -->
    <Icon Id="IsolateWarnings.ico" SourceFile="$(var.RepoRoot)IsolateWarnings\Warnings.ico" />
    <Property Id="ARPPRODUCTICON" Value="IsolateWarnings.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/russgreen/IsolateWarnings" />
    <Property Id="ARPCOMMENTS" Value="Isolate elements with warnings in Revit" />

    <!-- UI: shared template in UI.wxs, PNG art next to this file -->
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)isolate-warnings_banner.png" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)isolate-warnings_background.png" />
    <UIRef Id="WixUI_Minimal" />

    <!-- Install locations -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Isolate Warnings" />

      <!-- Revit 2027 and later is installed under Program Files -->
      <Directory Id="PfAutodeskFolder" Name="Autodesk">
        <Directory Id="PfRevitFolder" Name="Revit">
          <Directory Id="PfRevitAddinsFolder" Name="Addins">
            <?foreach Rel in $(var.RevitReleases)?>
            <?if $(Rel) >= $(var.FirstProgramFilesRelease)?>
            <Directory Id="Revit20$(Rel)Addins" Name="20$(Rel)">
              <Directory Id="Revit20$(Rel)App" Name="IsolateWarnings" />
            </Directory>
            <?endif?>
            <?endforeach?>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AutodeskFolder" Name="Autodesk">
        <Directory Id="RevitFolder" Name="Revit">
          <Directory Id="RevitAddinsFolder" Name="Addins">
            <?foreach Rel in $(var.RevitReleases)?>
            <?if $(Rel) < $(var.FirstProgramFilesRelease)?>
            <Directory Id="Revit20$(Rel)Addins" Name="20$(Rel)">
              <Directory Id="Revit20$(Rel)App" Name="IsolateWarnings" />
            </Directory>
            <?endif?>
            <?endforeach?>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Isolate Warnings" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppRegistry" />
      <ComponentGroupRef Id="RevitAddins" />
    </Feature>

    <ComponentGroup Id="AppRegistry" Directory="INSTALLFOLDER">
      <Component Id="ProductInformation">
        <RegistryValue Root="HKLM" Key="$(var.RegistryKey)" Name="Path" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="$(var.RegistryKey)" Name="Version" Type="string" Value="[ProductVersion]" />
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- Revit add-ins, one set of files per supported Revit release -->
    <ComponentGroup Id="RevitAddins">
      <?foreach Rel in $(var.RevitReleases)?>
      <ComponentGroupRef Id="Revit20$(Rel)" />
      <?endforeach?>
    </ComponentGroup>

    <?foreach Rel in $(var.RevitReleases)?>
    <ComponentGroup Id="Revit20$(Rel)">
      <Component Id="Revit20$(Rel)Addin" Directory="Revit20$(Rel)Addins">
        <?if $(Rel) >= $(var.FirstIsolatedRelease)?>
        <File Id="Revit20$(Rel)AddinFile" Name="IsolateWarnings.addin" Source="$(var.RepoRoot)IsolateWarnings\IsolateWarnings_Isolated.addin" />
        <?else?>
        <File Id="Revit20$(Rel)AddinFile" Name="IsolateWarnings.addin" Source="$(var.RepoRoot)IsolateWarnings\IsolateWarnings.addin" />
        <?endif?>
      </Component>
      <!-- A missing bin\x64\Release R$(Rel) folder only raises warning WIX8601 and ships an empty add-in folder: build every release first. -->
      <Files Include="$(var.RepoRoot)IsolateWarnings\bin\x64\Release R$(Rel)\**" Directory="Revit20$(Rel)App" />
    </ComponentGroup>
    <?endforeach?>
  </Package>
</Wix>
